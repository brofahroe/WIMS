{
  "name": "wims-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "import": "node scripts/importExcel.js",
    "import:db": "node scripts/importToSupabase.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc -b",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.1",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.4.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.8",
    "recharts": "^3.9.2",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.9.0",
    "husky": "^9.1.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.0.0"
